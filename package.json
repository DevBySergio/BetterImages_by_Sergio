{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "betterimages",
  "displayName": "BetterImages by Sergio",
  "description": "Collection of tools for working with images",
  "version": "1.4.0",
  "publisher": "DevBySergio",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevBySergio/BetterImages_by_Sergio"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "image",
    "optimization",
    "webp",
    "avif",
    "nextjs",
    "react",
    "crop"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "betterImages.processImage",
        "title": "Process with BetterImages",
        "icon": "$(device-camera)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "betterImagesSidebar",
          "title": "Better Images",
          "icon": "$(device-camera)"
        }
      ]
    },
    "views": {
      "betterImagesSidebar": [
        {
          "type": "webview",
          "id": "betterImages.toolboxView",
          "name": "Toolbox"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "when": "resourceExtname =~ /\\.(png|jpe?g|svg|gif|webp|avif)$/i",
          "command": "betterImages.processImage",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package:universal": "vsce package --out betterimages-1.4.0.vsix",
    "package:darwin-arm64": "vsce package --target darwin-arm64 --ignoreFile build/vscodeignore.darwin-arm64",
    "package:darwin-x64": "vsce package --target darwin-x64 --ignoreFile build/vscodeignore.darwin-x64",
    "package:linux-x64": "vsce package --target linux-x64 --ignoreFile build/vscodeignore.linux-x64",
    "package:win32-x64": "vsce package --target win32-x64 --ignoreFile build/vscodeignore.win32-x64",
    "package:all": "npm run package:darwin-arm64 && npm run package:darwin-x64 && npm run package:linux-x64 && npm run package:win32-x64"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "sharp": "^0.34.5"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "^0.34.5",
    "@img/sharp-darwin-x64": "^0.34.5",
    "@img/sharp-libvips-darwin-arm64": "^1.2.4",
    "@img/sharp-libvips-darwin-x64": "^1.2.4",
    "@img/sharp-libvips-linux-x64": "^1.2.4",
    "@img/sharp-linux-x64": "^0.34.5",
    "@img/sharp-win32-x64": "^0.34.5"
  },
  "overrides": {
    "diff": "^8.0.2",
    "serialize-javascript": "^7.0.5"
  }
}
